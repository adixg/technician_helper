# Copy to .env and fill in. Never commit the real .env.

# Hugging Face access token — used for sentence-transformers downloads and the
# Inference API. Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Optional overrides (defaults shown) ---------------------------------
# WEAVIATE_HOST=localhost
# WEAVIATE_HTTP_PORT=8080
# WEAVIATE_GRPC_PORT=50051
# MANUAL_COLLECTION=ManualChunk
# INCIDENT_COLLECTION=IncidentLogs
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Reliability / observability
# LLM_TIMEOUT=60
# LLM_MAX_ATTEMPTS=3
# LLM_REPAIR_ATTEMPTS=2
# WEAVIATE_CONNECT_ATTEMPTS=5
# WEAVIATE_CONNECT_BACKOFF=1.0
# LOG_LEVEL=INFO

# Evaluation / experiment tracking
# EVAL_K=5
# MLFLOW_ENABLED=false
# RUNS_DIR=runs
